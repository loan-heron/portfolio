    {
      "name": "03 - Auth API",
      "item": [
        {
          "name": "POST /api/auth/register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = Date.now();",
                  "pm.collectionVariables.set('userEmail', `loan.test.${id}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('success=true', () => pm.expect(body.success).to.eql(true));",
                  "const setCookie = pm.response.headers.get('set-cookie') || '';",
                  "const m = setCookie.match(/auth_token=([^;]+)/);",
                  "if (m && m[1]) pm.collectionVariables.set('authToken', m[1]);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{userName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "POST /api/auth/login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('success=true', () => pm.expect(body.success).to.eql(true));",
            "const setCookie = pm.response.headers.get('set-cookie') || '';",
            "const m = setCookie.match(/auth_token=([^;]+)/);",
            "if (m && m[1]) pm.collectionVariables.set('authToken', m[1]);"
          ]}}]
        },
        {
          "name": "GET /api/auth/me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('email cohérent', () => pm.expect(body.data.email).to.eql(pm.collectionVariables.get('userEmail')));"
          ]}}]
        },
        {
          "name": "PUT /api/auth/me",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{userName}} Updated\",\n  \"email\": \"{{userEmail}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const setCookie = pm.response.headers.get('set-cookie') || '';",
            "const m = setCookie.match(/auth_token=([^;]+)/);",
            "if (m && m[1]) pm.collectionVariables.set('authToken', m[1]);"
          ]}}]
        },
        {
          "name": "PUT /api/auth/me/password",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{userPassword}}\",\n  \"newPassword\": \"{{userNewPassword}}\",\n  \"confirmPassword\": \"{{userNewPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/me/password"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('userPassword', pm.collectionVariables.get('userNewPassword'));"
          ]}}]
        },
        {
          "name": "POST /api/auth/login (after password change)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const setCookie = pm.response.headers.get('set-cookie') || '';",
            "const m = setCookie.match(/auth_token=([^;]+)/);",
            "if (m && m[1]) pm.collectionVariables.set('authToken', m[1]);"
          ]}}]
        },
        {
          "name": "POST /api/auth/logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": "{{baseUrl}}/api/auth/logout"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}]
        }
      ]
    },
    {
      "name": "04 - Contact API",
      "item": [
        {
          "name": "POST /api/contact",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Loan Test\",\n  \"email\": \"{{userEmail}}\",\n  \"message\": \"Message de test Postman pour vérifier /api/contact.\"\n}"
            },
            "url": "{{baseUrl}}/api/contact"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const code = pm.response.code;",
            "pm.test('Status attendu (200/500/502)', () => pm.expect([200,500,502]).to.include(code));",
            "const body = pm.response.json();",
            "if (code === 200) {",
            "  pm.test('success=true si SMTP OK', () => pm.expect(body.success).to.eql(true));",
            "} else {",
            "  pm.test('success=false si SMTP KO', () => pm.expect(body.success).to.eql(false));",
            "}"
          ]}}]
        }
      ]
    },
