    {
      "name": "06 - Chatbot API",
      "item": [
        {
          "name": "POST /api/chatbot (general)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"persona\": \"general\",\n  \"message\": \"Donne 3 conseils pour améliorer une landing page en restant factuel.\",\n  \"history\": []\n}"
            },
            "url": "{{baseUrl}}/api/chatbot"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const code = pm.response.code;",
            "pm.test('Status attendu (200/429/500/502/503)', () => pm.expect([200,429,500,502,503]).to.include(code));",
            "const body = pm.response.json();",
            "if (code === 200) {",
            "  pm.test('reply présent', () => pm.expect(body.data.reply).to.be.a('string').and.not.empty);",
            "}"
          ]}}]
        }
      ]
