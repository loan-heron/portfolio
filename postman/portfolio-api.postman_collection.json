{
  "info": {
    "name": "Portfolio API - Full Test Suite",
    "description": "Collection Postman complète pour tester l'API Portfolio (auth, portfolio, business, contact, analytics, chatbot, academy, dashboard).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "userName", "value": "Loan Test" },
    { "key": "userEmail", "value": "" },
    { "key": "userPassword", "value": "TestPass#2026" },
    { "key": "userNewPassword", "value": "TestPass#2026!" },
    { "key": "authToken", "value": "" },
    { "key": "projectId", "value": "1" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('userEmail')) {",
          "  const id = Date.now();",
          "  pm.collectionVariables.set('userEmail', `loan.test.${id}@example.com`);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Portfolio Public API",
      "item": [
        {
          "name": "GET /api/portfolio",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/portfolio"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success=true', () => pm.expect(body.success).to.eql(true));",
                  "pm.test('data.person présent', () => pm.expect(body.data).to.have.property('person'));",
                  "pm.test('data.projects tableau', () => pm.expect(Array.isArray(body.data.projects)).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/portfolio/person",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/portfolio/person" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('person.name existe', () => pm.expect(body.data.name).to.be.a('string'));"
          ]}}]
        },
        {
          "name": "GET /api/portfolio/skills",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/portfolio/skills" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('skills frontend existe', () => pm.expect(body.data).to.have.property('frontend'));"
          ]}}]
        },
        {
          "name": "GET /api/portfolio/projects",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/portfolio/projects" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('projects est un tableau', () => pm.expect(Array.isArray(body.data)).to.eql(true));"
          ]}}]
        },
        {
          "name": "GET /api/portfolio/projects/:id",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/portfolio/projects/{{projectId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('project.id présent', () => pm.expect(body.data.id).to.exist);"
          ]}}]
        },
        {
          "name": "GET /api/portfolio/projects/999999 (not found)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/portfolio/projects/999999" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 404', () => pm.response.to.have.status(404));",
            "const body = pm.response.json();",
            "pm.test('success=false', () => pm.expect(body.success).to.eql(false));"
          ]}}]
        },
        {
          "name": "GET /api/portfolio/experience",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/portfolio/experience" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('experience tableau', () => pm.expect(Array.isArray(body.data)).to.eql(true));"
          ]}}]
        }
      ]
    },
