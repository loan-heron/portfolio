# Configuration Port
PORT=3000

# Environnement
NODE_ENV=development

# CORS (Pour les requêtes cross-origin si nécessaire)
CORS_ORIGIN=*

# Email SMTP (obligatoire pour /api/contact)
# Exemple Gmail SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=ton-adresse@gmail.com
# SMTP_PASS=mot-de-passe-application
# SMTP_FROM=Portfolio Contact <ton-adresse@gmail.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Destinataire des messages de contact
CONTACT_RECEIVER=heronloan@gmail.com

# JWT / Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h
ADMIN_NAME=Loan Heron
ADMIN_EMAIL=admin@loanheron.dev
ADMIN_PASSWORD=ChangeThisPassword123!

# OpenAI Chatbot
OPENAI_CHAT_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CHATBOT_RATE_WINDOW_MS=60000
CHATBOT_RATE_LIMIT_STANDARD=8
CHATBOT_RATE_LIMIT_PREMIUM=30

# MySQL (obligatoire pour comptes/premium/admin/prix dynamiques)
MYSQL_ENABLED=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=portfolio
MYSQL_CONNECTION_LIMIT=10
